{
  "mcpServers": {
    "sonarqube": {
      "command": "docker",
      "args": [
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_READ_ONLY",
        "mcp/sonarqube@sha256:925c88bc7cab2a1e1025b0bd43f0af504cd8ce1b99e9663ececaca914fb632e7"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${SONAR_READ_TOKEN}",
        "SONARQUBE_ORG": "md-nisar",
        "SONARQUBE_READ_ONLY": "true"
      }
    }
  }
}
