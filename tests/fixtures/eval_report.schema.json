{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuron.invalid/schemas/eval-report-1.json",
  "title": "neuron-eval report",
  "description": "Report written by `neuron-eval`; report_version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "model",
    "git_sha",
    "dataset_versions",
    "trials",
    "infrastructure_errors",
    "suites"
  ],
  "properties": {
    "report_version": { "const": 1 },
    "model": { "type": "string", "minLength": 1 },
    "git_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|unknown)$" },
    "dataset_versions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/suiteName" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "trials": { "type": "integer", "minimum": 1 },
    "infrastructure_errors": { "type": "integer", "minimum": 0 },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/suiteName" },
      "additionalProperties": { "$ref": "#/$defs/suite" }
    }
  },
  "$defs": {
    "suiteName": { "enum": ["single_turn", "multi_turn", "security"] },
    "count": { "type": "integer", "minimum": 0 },
    "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "milliseconds": { "type": ["number", "null"], "minimum": 0 },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_tokens",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "reasoning_tokens"
      ],
      "properties": {
        "total_tokens": { "$ref": "#/$defs/count" },
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "cache_read_tokens": { "$ref": "#/$defs/count" },
        "reasoning_tokens": { "$ref": "#/$defs/count" }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "cases",
        "trials",
        "passes",
        "quality_failures",
        "infrastructure_errors",
        "pass_rate",
        "wilson_95",
        "pass_hat_k",
        "inconclusive_cases"
      ],
      "properties": {
        "cases": { "$ref": "#/$defs/count" },
        "trials": { "$ref": "#/$defs/count" },
        "passes": { "$ref": "#/$defs/count" },
        "quality_failures": { "$ref": "#/$defs/count" },
        "infrastructure_errors": { "$ref": "#/$defs/count" },
        "pass_rate": { "$ref": "#/$defs/rate" },
        "wilson_95": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["low", "high"],
              "properties": {
                "low": { "$ref": "#/$defs/rate" },
                "high": { "$ref": "#/$defs/rate" }
              }
            }
          ]
        },
        "pass_hat_k": { "$ref": "#/$defs/rate" },
        "inconclusive_cases": { "$ref": "#/$defs/count" }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reasons", "duration_ms", "tokens", "error_code"],
      "properties": {
        "outcome": { "enum": ["pass", "fail", "infrastructure_error"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "duration_ms": { "$ref": "#/$defs/milliseconds" },
        "tokens": { "$ref": "#/$defs/tokens" },
        "error_code": { "type": ["string", "null"] }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "category",
        "passed",
        "reasons",
        "trials",
        "passes",
        "quality_failures",
        "infrastructure_errors",
        "trial_results"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "trials": { "type": "integer", "minimum": 1 },
        "passes": { "$ref": "#/$defs/count" },
        "quality_failures": { "$ref": "#/$defs/count" },
        "infrastructure_errors": { "$ref": "#/$defs/count" },
        "trial_results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trial" } }
      }
    },
    "suite": {
      "allOf": [{ "$ref": "#/$defs/metrics" }],
      "type": "object",
      "required": ["dataset_version", "latency_ms", "tokens", "categories", "results"],
      "properties": {
        "dataset_version": { "type": "string", "minLength": 1 },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p50", "p95"],
          "properties": {
            "p50": { "$ref": "#/$defs/milliseconds" },
            "p95": { "$ref": "#/$defs/milliseconds" }
          }
        },
        "tokens": { "$ref": "#/$defs/tokens" },
        "categories": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metrics" }
        },
        "results": { "type": "array", "items": { "$ref": "#/$defs/case" } }
      }
    }
  }
}
