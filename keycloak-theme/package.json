{
    "name": "neuron-keycloak-theme",
    "private": true,
    "version": "0.0.0",
    "description": "Keycloak login theme for Neuron (Keycloakify + shadcn/ui + Tailwind)",
    "type": "module",
    "engines": {
        "node": ">=22.22.0 <23",
        "npm": ">=10.9.4 <11"
    },
    "packageManager": "npm@10.9.4",
    "scripts": {
        "postinstall": "keycloakify sync-extensions",
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "dependencies": {
        "@fontsource-variable/figtree": "5.3.0",
        "@fontsource-variable/geist": "5.3.0",
        "@fontsource-variable/ibm-plex-sans": "5.3.0",
        "@fontsource-variable/inter": "5.3.0",
        "@fontsource-variable/jetbrains-mono": "5.3.0",
        "@fontsource-variable/lora": "5.3.0",
        "@fontsource-variable/manrope": "5.3.0",
        "@fontsource-variable/playfair-display": "5.3.0",
        "@fontsource-variable/source-sans-3": "5.3.1",
        "@keycloakify/login-ui": "250004.7.5",
        "@tailwindcss/vite": "4.3.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "i18next": "26.5.12",
        "input-otp": "1.5.0",
        "keycloakify": "11.16.4",
        "lucide-react": "1.65.0",
        "radix-ui": "1.8.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.9",
        "react-icons": "5.7.0",
        "rfc4648": "1.5.4",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.3",
        "tsafe": "^1.8.5",
        "tw-animate-css": "1.4.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "axe-core": "4.14.0",
        "jsdom": "29.1.1",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
