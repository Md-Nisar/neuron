# =============================================================================
# APPLICATION
# =============================================================================

APP_ENV=development
# Bind address and port for `neuron-api`; a non-loopback host needs APP_ENV set explicitly.
# The image sets APP_HOST=0.0.0.0. APP_PORT also accepts PORT
# (Render sets it); a bare PORT wins over APP_PORT.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_NAME=neuron-agent
# Defaults to the installed package version (pyproject.toml); set only to override.
# APP_VERSION=


# =============================================================================
# OPENAI / LLM
# =============================================================================

OPENAI_API_KEY=
# Free-tier NVIDIA API catalog models for development: set APP_DEFAULT_MODEL=nvidia:<model-id>.
NVIDIA_API_KEY=
# Anthropic: set APP_DEFAULT_MODEL=anthropic:<model-id>. Not verified live in v0.7.0 (no funded key).
ANTHROPIC_API_KEY=
APP_DEFAULT_MODEL=openai:gpt-5.4-mini
# Models to try, in order, when the default model fails after its retries (a JSON list).
# Each needs its provider key. neuron-eval refuses a non-empty list.
# APP_FALLBACK_MODELS=["anthropic:<model-id>"]
APP_MAX_OUTPUT_TOKENS=2000
# MCP tools (ADR 0009): a JSON file listing the servers and a pin per exposed tool. Unset means
# none. Streamable HTTP over https only (loopback http in development and test).
# APP_MCP_SERVERS=./mcp-servers.json   (`neuron-mcp-pin <url>` prints an entry; `scripts/mcp_reference_server.py` serves a local one)
# A bearer token per server name, never the caller's token: {"units": "<token>"}.
# APP_MCP_BEARER_TOKENS=
# Largest text result accepted from an MCP tool; anything else is an error.
# APP_MCP_MAX_OUTPUT_BYTES=16384
# Per-user memory (ADR 0009): the assistant remembers what a user asks it to, after approval.
# Needs persistence for approvals (not APP_CHECKPOINTER=none). Off by default.
# APP_MEMORY_ENABLED=false
# APP_MEMORY_MAX_ITEMS=50
# APP_MEMORY_MAX_CHARS=500
# Forget memories after this many days (unset: keep until the user deletes them).
# APP_MEMORY_TTL_DAYS=


# =============================================================================
# AGENT EXECUTION
# =============================================================================

APP_REQUEST_TIMEOUT_SECONDS=60
APP_TOOL_TIMEOUT_SECONDS=20
APP_MAX_AGENT_ITERATIONS=8
APP_MAX_PROMPT_CHARS=12000
APP_MAX_REQUEST_BODY_BYTES=65536
APP_PROVIDER_MAX_RETRIES=2


# =============================================================================
# RATE LIMITING
# =============================================================================

APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_REQUESTS_PER_WINDOW=60
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_RATE_LIMIT_BURST=20
# Forwarded client IPs are honored only when the immediate peer matches one of these
# trusted addresses/CIDRs; empty means ignore forwarded headers entirely. Staging and
# production refuse it unset (an explicit [] is accepted; an empty `APP_TRUSTED_PROXIES=` is a
# parse error) and refuse ranges broader than /8 (IPv4) or /16 (IPv6).
# They also refuse APP_RATE_LIMIT_ENABLED=false.
APP_TRUSTED_PROXIES=[]


# =============================================================================
# THREAD PERSISTENCE AND STREAMING (ADR 0005)
# =============================================================================

# auto (memory in development/test) | memory | postgres | none. Staging/production refuse auto
# and memory: set postgres, or none for a deliberately stateless deployment (logged as a
# warning at start-up).
APP_CHECKPOINTER=auto
# Create/migrate checkpoint tables at startup (local use); staging/production refuse this and run `setup` as a deploy step.
APP_CHECKPOINTER_SETUP_ON_STARTUP=false
# Direct, non-pooled DSN of the migrator role for `python -m neuron_agent.persistence.cli setup`.
# Required there in staging/production (no fallback); development falls back to
# APP_POSTGRES_DSN. Read only by persistence.cli. Never commit a real DSN.
APP_POSTGRES_MIGRATION_DSN=
# Role `setup` grants DML to (the runtime DSN's user); see OPERATIONS.md.
APP_POSTGRES_APP_ROLE=neuron_app
# auto (memory in development/test) | memory | postgres. Staging/production refuse auto;
# production also refuses memory (per-process guards). postgres needs APP_POSTGRES_DSN even with
# APP_CHECKPOINTER=none; the rate limit, token budget and run guards then live in Postgres
# (ADR 0008 decision 8).
APP_LIMITS_BACKEND=auto
# Required when APP_CHECKPOINTER=postgres or APP_LIMITS_BACKEND=postgres. Never commit a real DSN.
# Staging/production (runtime and migration DSN) need an explicit sslmode in the DSN itself:
# verify-full in production; staging also accepts require or verify-ca (ADR 0008 decision 17).
APP_POSTGRES_DSN=
# Connections per process (1-100) and wait for a free connection in seconds (1-120).
APP_POSTGRES_POOL_MAX_SIZE=10
APP_POSTGRES_POOL_TIMEOUT_SECONDS=10
# Model-input history budget in approximate tokens (256-200000).
APP_MAX_HISTORY_TOKENS=8000
# Stored messages per thread; oldest whole turns are evicted beyond it (2-10000).
APP_MAX_THREAD_MESSAGES=200
# Maximum serialized /v1/me/export response size (65536-50000000 bytes).
APP_USER_DATA_EXPORT_MAX_BYTES=5000000
# Seconds between SSE heartbeat comments on /v1/agent/stream (1-120).
APP_STREAM_HEARTBEAT_SECONDS=15
# Whole-run budget for invoke and stream, in seconds (1-900).
APP_RUN_TIMEOUT_SECONDS=120
# On SIGTERM, /health/ready turns 503 at once and new runs are refused after this many
# seconds (0-60); Uvicorn then waits APP_RUN_TIMEOUT_SECONDS + 10 for in-flight runs.
# The platform's termination grace must exceed the sum of the three.
APP_SHUTDOWN_DRAIN_SECONDS=5
# Open streams per process before 503 too_many_streams (1-10000).
APP_MAX_CONCURRENT_STREAMS=100
# Active invoke+stream runs allowed per principal (1-1000).
APP_MAX_CONCURRENT_RUNS_PER_USER=2
# Rolling provider token budget per principal (1-10000000) and its window (1-86400s).
APP_USER_TOKEN_BUDGET=100000
APP_USER_TOKEN_BUDGET_WINDOW_SECONDS=3600
# Threads inactive longer than this are deleted by `make prune-threads` (1-3650 days).
APP_THREAD_RETENTION_DAYS=30


# =============================================================================
# AUTHENTICATION (ADR 0006; required as APP_AUTH_MODE=jwt outside local mode)
# =============================================================================

# none (development/test only: no authentication, one untrusted local identity) | jwt.
# staging/production must use jwt. For local jwt mode without an identity provider, run
# `make dev-auth >> .env` and `make dev-jwks` (README "Authentication").
APP_AUTH_MODE=none
# Expected `iss`, exactly as your identity provider issues it. Required in jwt mode.
APP_AUTH_ISSUER=
# Stable configured issuer label recorded in audit events; never the issuer URL.
# 1-64 characters of [A-Za-z0-9._-].
APP_AUTH_ISSUER_ID=default
# Also audit successful authentications (failures are always audited).
APP_AUTH_AUDIT_SUCCESS_ENABLED=false
# Expected `aud` (this API's identifier at the identity provider). Required in jwt mode.
APP_AUTH_AUDIENCE=
# The provider's JWKS endpoint. Required in jwt mode; must be https outside development, and in
# staging/production its host must not be loopback, link-local or private.
APP_AUTH_JWKS_URL=
# JSON array; only RS256/384/512 and ES256/384/512 are accepted.
APP_AUTH_ALGORITHMS=["RS256","ES256"]
# Clock skew allowed on exp/nbf/iat (0-300 seconds).
APP_AUTH_LEEWAY_SECONDS=30
# How long fetched signing keys are cached (1-86400 seconds); unknown kids refetch sooner.
APP_AUTH_JWKS_CACHE_SECONDS=300
# JWKS fetch timeout (1-30 seconds).
APP_AUTH_JWKS_TIMEOUT_SECONDS=5
# Largest accepted encoded token (1024-131072 bytes).
APP_AUTH_TOKEN_MAX_BYTES=16384
# Require the RFC 9068 `typ: at+jwt` header.
APP_AUTH_REQUIRE_TYP=false
# Scope may be a space-delimited string or list; `scp` is also accepted as fallback.
APP_AUTH_SCOPE_CLAIM=scope
# Optional role claim and explicit role-to-permission mapping (JSON object), e.g.
# {"neuron-user":["agent:invoke","threads:read","threads:delete"]}.
APP_AUTH_ROLES_CLAIM=roles
APP_AUTH_ROLE_PERMISSIONS={}
# Keys thread ownership: HMAC(key, issuer + subject). Required in jwt mode; at least 32
# characters, kept stable across replicas and restarts. Changing it orphans every thread
# (OPERATIONS.md "Rotating APP_IDENTITY_HASH_KEY").
APP_IDENTITY_HASH_KEY=


# =============================================================================
# HTTP SURFACE (see OPERATIONS.md "HTTP Surface")
# =============================================================================

# JSON array of exact browser origins (lowercase scheme://host[:port]); "*" is rejected.
# Empty disables CORS.
APP_CORS_ALLOWED_ORIGINS=[]
# Serve /docs, /redoc and /openapi.json. Unset: true in development/test, false in
# staging/production. Production refuses true.
# APP_EXPOSE_API_DOCS=
# JSON array of accepted lowercase hostnames, no scheme or port ("*.example.com" allowed);
# other hosts get 400.
# Empty disables the check in development/test; staging/production refuse it empty, "*" and
# a wildcard over a whole TLD such as "*.com".
# /health/* is always exempt.
APP_ALLOWED_HOSTS=[]
# Strict-Transport-Security max-age in seconds; 0 disables. Set only behind TLS.
# Required (> 0) in production; 0 disables HSTS elsewhere.
APP_HSTS_MAX_AGE_SECONDS=0


# =============================================================================
# LANGSMITH / OBSERVABILITY
# =============================================================================

# APP_ENABLE_LANGSMITH is the only switch for LangSmith tracing; a LANGSMITH_TRACING (or
# LANGCHAIN_TRACING_V2) set in the shell is overridden. Outside development, traces carry no
# prompts or answers unless APP_LANGSMITH_CONTENT_APPROVED=true. Staging and production with
# LangSmith enabled require LANGSMITH_API_KEY.
APP_ENABLE_LANGSMITH=false
APP_LANGSMITH_CONTENT_APPROVED=false
# Production refuses APP_LANGSMITH_CONTENT_APPROVED=true unless this names the approval record
# (a ticket, ADR or review reference; never a secret).
# APP_LANGSMITH_CONTENT_APPROVAL_RECORD=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neuron-agent-development

# OpenTelemetry traces and metrics over OTLP/HTTP to a Collector (ADR 0007). Off by default;
# when off, nothing is exported. Prompts, answers and tool content are never recorded.
APP_OTEL_ENABLED=false
# APP_OTEL_SERVICE_NAME=neuron-agent
APP_OTEL_TRACES_SAMPLE_RATIO=1.0
APP_OTEL_EXPORT_TIMEOUT_SECONDS=10
# Standard OpenTelemetry names. Headers are comma-separated, URL-encoded key=value pairs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
