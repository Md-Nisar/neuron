# =============================================================================
# APPLICATION
# =============================================================================

APP_ENV=development
APP_LOG_LEVEL=INFO
APP_NAME=neuron-agent
APP_VERSION=0.3.0


# =============================================================================
# OPENAI / LLM
# =============================================================================

OPENAI_API_KEY=
APP_DEFAULT_MODEL=openai:gpt-5.4-mini
APP_MAX_OUTPUT_TOKENS=2000


# =============================================================================
# AGENT EXECUTION
# =============================================================================

APP_REQUEST_TIMEOUT_SECONDS=60
APP_TOOL_TIMEOUT_SECONDS=20
APP_MAX_AGENT_ITERATIONS=5
APP_MAX_PROMPT_CHARS=12000
APP_MAX_REQUEST_BODY_BYTES=65536
APP_PROVIDER_MAX_RETRIES=2


# =============================================================================
# RATE LIMITING
# =============================================================================

APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_REQUESTS_PER_WINDOW=60
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_RATE_LIMIT_BURST=20
# Forwarded client IPs are honored only when the immediate peer matches one of these
# trusted addresses/CIDRs; empty means ignore forwarded headers entirely.
APP_TRUSTED_PROXIES=[]


# =============================================================================
# THREAD PERSISTENCE AND STREAMING (ADR 0005)
# =============================================================================

# auto (memory in development/test, none in staging/production) | memory | postgres | none.
# memory is rejected in staging/production.
APP_CHECKPOINTER=auto
# Create/migrate checkpoint tables at startup (local use); production runs `make db-setup`.
APP_CHECKPOINTER_SETUP_ON_STARTUP=false
# Required when APP_CHECKPOINTER=postgres. Never commit a real DSN.
APP_POSTGRES_DSN=
# Connections per process (1-100) and wait for a free connection in seconds (1-120).
APP_POSTGRES_POOL_MAX_SIZE=10
APP_POSTGRES_POOL_TIMEOUT_SECONDS=10
# Model-input history budget in approximate tokens (256-200000).
APP_MAX_HISTORY_TOKENS=8000
# Stored messages per thread; oldest whole turns are evicted beyond it (2-10000).
APP_MAX_THREAD_MESSAGES=200
# Seconds between SSE heartbeat comments on /v1/agent/stream (1-120).
APP_STREAM_HEARTBEAT_SECONDS=15
# Whole-run budget for invoke and stream, in seconds (1-900).
APP_RUN_TIMEOUT_SECONDS=120
# Open streams per process before 503 too_many_streams (1-10000).
APP_MAX_CONCURRENT_STREAMS=100
# Active invoke+stream runs allowed per principal (1-1000).
APP_MAX_CONCURRENT_RUNS_PER_USER=2
# Rolling provider token budget per principal (1-10000000) and its window (1-86400s).
APP_USER_TOKEN_BUDGET=100000
APP_USER_TOKEN_BUDGET_WINDOW_SECONDS=3600
# Threads inactive longer than this are deleted by `make prune-threads` (1-3650 days).
APP_THREAD_RETENTION_DAYS=30


# =============================================================================
# AUTHENTICATION (ADR 0006; required as APP_AUTH_MODE=jwt outside local mode)
# =============================================================================

# none is allowed only in development/test; staging/production must use jwt.
APP_AUTH_MODE=none
APP_AUTH_ISSUER=
# Stable configured issuer label recorded in audit events; never the issuer URL.
APP_AUTH_ISSUER_ID=default
APP_AUTH_AUDIT_SUCCESS_ENABLED=false
APP_AUTH_AUDIENCE=
APP_AUTH_JWKS_URL=
# JSON array; asymmetric algorithms only.
APP_AUTH_ALGORITHMS=["RS256","ES256"]
APP_AUTH_LEEWAY_SECONDS=30
APP_AUTH_JWKS_CACHE_SECONDS=300
APP_AUTH_JWKS_TIMEOUT_SECONDS=5
APP_AUTH_TOKEN_MAX_BYTES=16384
APP_AUTH_REQUIRE_TYP=false
# Scope may be a space-delimited string or list; `scp` is also accepted as fallback.
APP_AUTH_SCOPE_CLAIM=scope
# Optional role claim and explicit role-to-permission mapping (JSON object).
APP_AUTH_ROLES_CLAIM=roles
APP_AUTH_ROLE_PERMISSIONS={}
# Required in jwt mode; use a deployment secret of at least 32 characters.
APP_IDENTITY_HASH_KEY=


# =============================================================================
# LANGSMITH / OBSERVABILITY
# =============================================================================

APP_ENABLE_LANGSMITH=false
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=neuron-agent-development
